{
  "name": "@homesplit/api",
  "version": "1.0.0",
  "private": true,
  "description": "HomeSplit API — Hono on Cloudflare Workers with D1.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute homesplit-db --local --file=migrations/0001_init.sql",
    "db:migrate": "wrangler d1 execute homesplit-db --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.5",
    "@cloudflare/workers-types": "^4.20241106.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "wrangler": "^3.86.0"
  }
}
